<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Progress dots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="24dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_dot_active" />

        <View
            android:id="@+id/dot2"
            android:layout_width="8dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot_inactive" />

    </LinearLayout>

    <!-- FrameLayout holding both steps -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===== STEP 1: Weight ===== -->
        <ScrollView
            android:id="@+id/stepWeight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Welcome! 👋"
                    android:textColor="@color/dark_text"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="40dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Let's personalize your daily\ncalorie target"
                    android:textColor="@color/secondary_text"
                    android:textSize="15sp" />

                <!-- Weight input card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="40dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="How much do you weigh?"
                            android:textColor="@color/dark_text"
                            android:textSize="17sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etWeight"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_search_bar"
                                android:fontFamily="@font/poppins_semibold"
                                android:gravity="center"
                                android:hint="70"
                                android:inputType="numberDecimal"
                                android:maxLength="5"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:textColor="@color/dark_text"
                                android:textColorHint="@color/secondary_text"
                                android:textSize="28sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="kg"
                                android:textColor="@color/secondary_text"
                                android:textSize="22sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Continue →"
                    android:textSize="16sp"
                    android:textColor="@color/on_primary"
                    android:includeFontPadding="false"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </ScrollView>

        <!-- ===== STEP 2: Goal ===== -->
        <ScrollView
            android:id="@+id/stepGoal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="What's your goal?"
                    android:textColor="@color/dark_text"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="We'll calculate your ideal\ndaily calorie target"
                    android:textColor="@color/secondary_text"
                    android:textSize="15sp" />

                <!-- Lose Weight -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="🏃"
                            android:textSize="26sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Lose Weight"
                                android:textColor="@color/dark_text"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Calorie deficit"
                                android:textColor="@color/secondary_text"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:id="@+id/checkLose"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_check_unselected" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Maintain Weight -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMaintain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="⚖️"
                            android:textSize="26sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Maintain Weight"
                                android:textColor="@color/dark_text"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Stay at current weight"
                                android:textColor="@color/secondary_text"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:id="@+id/checkMaintain"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_check_unselected" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Gain Weight -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="💪"
                            android:textSize="26sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Gain Weight"
                                android:textColor="@color/dark_text"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Calorie surplus"
                                android:textColor="@color/secondary_text"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:id="@+id/checkGain"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_check_unselected" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetStarted"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Get Started 🍳"
                    android:textSize="16sp"
                    android:textColor="@color/on_primary"
                    android:includeFontPadding="false"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>
